        <mxCell id="cell12_2" value="&lt;b&gt;Selector address bit 0 (LSB)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="495" y="736" width="560" height="43" as="geometry"/></mxCell>
        <mxCell id="cell12_3" value="&lt;b&gt;selector.c&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1055" y="736" width="245" height="43" as="geometry"/></mxCell>
        <mxCell id="cell13_0" value="&lt;b&gt;PB14&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="779" width="150" height="43" as="geometry"/></mxCell>
        <mxCell id="cell13_1" value="&lt;b&gt;GPIO output OD 2 MHz (*)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="779" width="295" height="43" as="geometry"/></mxCell>
        <mxCell id="cell13_2" value="&lt;b&gt;Selector address bit 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="495" y="779" width="560" height="43" as="geometry"/></mxCell>
        <mxCell id="cell13_3" value="&lt;b&gt;selector.c&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1055" y="779" width="245" height="43" as="geometry"/></mxCell>
        <mxCell id="cell14_0" value="&lt;b&gt;PB15&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="822" width="150" height="43" as="geometry"/></mxCell>
        <mxCell id="cell14_1" value="&lt;b&gt;GPIO output OD 2 MHz (*)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="822" width="295" height="43" as="geometry"/></mxCell>
        <mxCell id="cell14_2" value="&lt;b&gt;Selector address bit 2 (MSB)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="495" y="822" width="560" height="43" as="geometry"/></mxCell>
        <mxCell id="cell14_3" value="&lt;b&gt;selector.c&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1055" y="822" width="245" height="43" as="geometry"/></mxCell>
        <mxCell id="cell15_0" value="&lt;b&gt;PC13&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="865" width="150" height="43" as="geometry"/></mxCell>
        <mxCell id="cell15_1" value="&lt;b&gt;GPIO output PP 2 MHz&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="865" width="295" height="43" as="geometry"/></mxCell>
        <mxCell id="cell15_2" value="&lt;b&gt;Onboard LED; driven low in initLed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="495" y="865" width="560" height="43" as="geometry"/></mxCell>
        <mxCell id="cell15_3" value="&lt;b&gt;ledtest.c&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1055" y="865" width="245" height="43" as="geometry"/></mxCell>
        <mxCell id="pa2" value="&lt;b&gt;PA2 ownership conflict&lt;/b&gt;&lt;br&gt;&lt;br&gt;motorControlInit configures PA2 as IN1.&lt;br&gt;Stepper start/stop code also drives PA2 low/high.&lt;br&gt;An electrical / firmware mapping decision is needed;&lt;br&gt;the diagram preserves both uses found in source." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fde8e7;strokeColor=#bb5450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="175" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="selectoractual" value="&lt;b&gt;(*) Selector pins are actually open-drain&lt;/b&gt;&lt;br&gt;&lt;br&gt;initSelector() ORs 0x2222 into reset CRH = 0x44444444.&lt;br&gt;PB12–PB15 nibbles become 0x6, not 0x2:&lt;br&gt;MODE = 10 (2 MHz); CNF = 01 (open-drain).&lt;br&gt;Writing HIGH releases the pin; external pull-ups&lt;br&gt;and compatible logic levels are not documented.&lt;br&gt;The initial clear uses 0x8 &lt;&lt; 13, not a 3-bit mask." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fde8e7;strokeColor=#bb5450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="355" width="520" height="200" as="geometry"/></mxCell>
        <mxCell id="dcnotes" value="&lt;b&gt;DC driver evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;motor.c links to SparkFun TB6612FNG, but the&lt;br&gt;comment calls it “TB303A1”. Confirm installed part.&lt;br&gt;PWMA/B and STBY (+5 V) appear in comments.&lt;br&gt;A/B input and output pairing is ambiguous;&lt;br&gt;no electrical channel-paralleling wiring is assumed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="585" width="520" height="160" as="geometry"/></mxCell>
        <mxCell id="lcdnotes" value="&lt;b&gt;Display / buttons / valve details&lt;/b&gt;&lt;br&gt;&lt;br&gt;LCD backpack part and supply are not specified.&lt;br&gt;I²C requires external pull-ups; rail/value unknown.&lt;br&gt;Buttons use MCU pull-ups. No timed debounce exists.&lt;br&gt;Only valve 1 is implemented; power stage unknown.&lt;br&gt;Backpack bits 0–3: RS / RW / E / backlight.&lt;br&gt;Bits 4–7: LCD D4–D7 (from lcd.c byte masks)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="775" width="520" height="180" as="geometry"/></mxCell>
        <mxCell id="powerheading" value="Power and fixed hardware connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="960" width="1800" height="45" as="geometry"/></mxCell>
        <mxCell id="powerinput" value="&lt;b&gt;Power source / regulation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Input supply and regulator details&lt;br&gt;are absent from repository.&lt;br&gt;Rails below are functional domains." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f2eafa;strokeColor=#9165b0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1050" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="logic" value="&lt;b&gt;MCU / logic domain&lt;/b&gt;&lt;br&gt;&lt;br&gt;Blue Pill 3.3 V + GND&lt;br&gt;ST-Link can optionally power 3.3 V&lt;br&gt;BOOT0 = 0; reset hardware on board" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f2eafa;strokeColor=#9165b0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="545" y="1025" width="425" height="125" as="geometry"/></mxCell>
        <mxCell id="external" value="&lt;b&gt;External logic connections&lt;/b&gt;&lt;br&gt;&lt;br&gt;A4988 VDD; selector logic/pull-ups; LCD VCC and I²C pull-ups;&lt;br&gt;DC driver VCC. Actual rail voltages / level compatibility unspecified.&lt;br&gt;DC STBY tied to +5 V according to motor.c comment only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f2eafa;strokeColor=#9165b0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="1025" width="760" height="125" as="geometry"/></mxCell>
        <mxCell id="motorrail" value="&lt;b&gt;Actuator supply domain(s)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Voltage / current ratings unspecified&lt;br&gt;A4988 VMOT/VBB; DC driver VM&lt;br&gt;Valve power supply" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f2eafa;strokeColor=#9165b0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="545" y="1230" width="425" height="125" as="geometry"/></mxCell>
        <mxCell id="loads" value="&lt;b&gt;Power stages and loads&lt;/b&gt;&lt;br&gt;&lt;br&gt;A4988 bank → conveyor and three referenced ingredient pumps.&lt;br&gt;DC H-bridge → ice auger. Valve switching stage → valve 1.&lt;br&gt;Local driver decoupling, phase-current settings and valve suppression&lt;br&gt;are hardware details not captured by MCU pin configuration." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="1230" width="760" height="145" as="geometry"/></mxCell>
        <mxCell id="edge1" value="regulated logic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9165b0;fontColor=#9165b0;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="powerinput" target="logic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge2" value="external logic supply rails TBD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9165b0;fontColor=#9165b0;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="powerinput" target="external"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="1010"/><mxPoint x="1500" y="1010"/></Array></mxGeometry></mxCell>
        <mxCell id="edge3" value="motor / valve supply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9165b0;fontColor=#9165b0;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="powerinput" target="motorrail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge4" value="actuator power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9165b0;fontColor=#9165b0;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="motorrail" target="loads"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gnd" value="&lt;b&gt;Ground reference&lt;/b&gt;&lt;br&gt;&lt;br&gt;MCU, ST-Link, selector, LCD backpack, A4988 modules, DC driver and valve control stage share the required signal ground reference; actual harness/layout is undocumented." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f2eafa;strokeColor=#9165b0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1420" width="1830" height="90" as="geometry"/></mxCell>
        <mxCell id="scope" value="&lt;b&gt;Coverage boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;All application peripheral register references and README SWD connections are represented. PB5 is included even though it has no functional use.&lt;br&gt;No homing/limit switch, encoder, cup sensor, flow sensor, liquid-level input, emergency-stop input or USB data path is implemented in this firmware.&lt;br&gt;Hardware quantity and supply/wiring details require a schematic or physical confirmation; unreferenced selector channels are not drawn as installed motors." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1540" width="1830" height="125" as="geometry"/></mxCell>
        <mxCell id="footer" value="PP = push-pull; OD = open-drain. “50 MHz / 2 MHz” are GPIO output-speed modes, not signal frequencies. Source audit: all application files in Src/ and Inc/valve.h." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#596579;" vertex="1" parent="1"><mxGeometry x="50" y="1680" width="1830" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
