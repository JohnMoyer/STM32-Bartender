                <mxCell id="cell14_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;rounded=0;fontStyle=0;fontSize=13;spacing=8;" value="&lt;b&gt;Selector address bit 2 (MSB)&lt;/b&gt;" vertex="1">
