  <diagram id="system" name="1 - System overview">
    <mxGraphModel dx="1940" dy="1460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="01 / STM32 Bartender — complete system" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=30;fontColor=#132b46;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1840" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Repository-derived functional block diagram • STM32F103C8T6 / Blue Pill • firmware baseline 8324f4f • 21 September 2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1830" height="55" as="geometry"/></mxCell>
        <mxCell id="mcu" value="&lt;b&gt;STM32F103C8T6 / Blue Pill&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;verticalAlign=top;spacingTop=16;fontSize=22;fillColor=#f5f9ff;" vertex="1" parent="1"><mxGeometry x="570" y="170" width="660" height="1020" as="geometry"/></mxCell>
        <mxCell id="clock" value="&lt;b&gt;Cortex-M3 + RCC / clock system&lt;/b&gt;&lt;br&gt;&lt;br&gt;HSI = 8 MHz; SYSCLK / HCLK / APB1 / APB2 = 8 MHz&lt;br&gt;Bare-metal main loop, recipe table, Flash and SRAM&lt;br&gt;No HAL / RTOS; see page 3 for timing and interrupts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="235" width="580" height="130" as="geometry"/></mxCell>
        <mxCell id="buttons" value="&lt;b&gt;Two push buttons&lt;/b&gt;&lt;br&gt;&lt;br&gt;Next drink / Start pour&lt;br&gt;Active low; switch to GND" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="exti" value="&lt;b&gt;GPIOB + AFIO + EXTI&lt;/b&gt;&lt;br&gt;&lt;br&gt;PB8 = Next; PB9 = Start&lt;br&gt;Internal pull-ups; falling edge&lt;br&gt;Shared EXTI9_5 interrupt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="400" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="edge1" value="PB8 / PB9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4d8865;fontColor=#4d8865;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="buttons" target="exti"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lcd" value="&lt;b&gt;LCD + I²C backpack&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 × 2 character display&lt;br&gt;Address 0x27 (7-bit)&lt;br&gt;Backpack part not specified&lt;br&gt;4-bit LCD interface / backlight" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="595" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="i2c" value="&lt;b&gt;I²C1 + GPIOB&lt;/b&gt;&lt;br&gt;&lt;br&gt;PB6 = SCL; PB7 = SDA&lt;br&gt;100 kHz nominal&lt;br&gt;Alternate-function open-drain&lt;br&gt;Queued writes + event IRQ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="595" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="edge2" value="SCL / SDA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4d8865;fontColor=#4d8865;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="i2c" target="lcd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="led" value="&lt;b&gt;Onboard LED&lt;/b&gt;&lt;br&gt;&lt;br&gt;PC13 driven low at startup" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="820" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="gpioc" value="&lt;b&gt;GPIOC&lt;/b&gt;&lt;br&gt;&lt;br&gt;PC13 push-pull output&lt;br&gt;initLed(); toggle API unused" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="820" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="edge3" value="PC13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4d8865;fontColor=#4d8865;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="gpioc" target="led"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="stlink" value="&lt;b&gt;ST-Link + development PC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Program / debug over SWD&lt;br&gt;GND; optional board 3.3 V&lt;br&gt;BOOT0 jumper = 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="995" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="swd" value="&lt;b&gt;SWD debug port&lt;/b&gt;&lt;br&gt;&lt;br&gt;PA13 = SWDIO&lt;br&gt;PA14 = SWCLK&lt;br&gt;README-documented interface" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="985" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="edge4" value="SWDIO / SWCLK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4d8865;fontColor=#4d8865;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="stlink" target="swd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="stepper" value="&lt;b&gt;Stepper subsystem&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM2 IRQ → PA1 STEP&lt;br&gt;PA0 DIR; PA2 /ENABLE*&lt;br&gt;TIM3 IRQ = pour/purge end&lt;br&gt;PB12 selector enable&lt;br&gt;PB13 / PB14 / PB15 address" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915" y="400" width="275" height="180" as="geometry"/></mxCell>
        <mxCell id="bank" value="&lt;b&gt;Selector → A4988 drivers → steppers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Channel 0: conveyor / cup carriage&lt;br&gt;Channel 1: ingredient pump at 440 mm&lt;br&gt;Channel 2: ingredient pump at 150 mm&lt;br&gt;Channel 3: ingredient pump at 250 mm&lt;br&gt;Channels 4–7: addressable, unused in recipes&lt;br&gt;See page 2; physical selector wiring unconfirmed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1400" y="395" width="450" height="210" as="geometry"/></mxCell>
        <mxCell id="edge5" value="STEP / DIR / EN*
select + address" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stepper" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dc" value="&lt;b&gt;DC motor subsystem&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM1 CH1 → PA8 PWM&lt;br&gt;16 kHz; variable duty&lt;br&gt;PA2 IN1*; PA3 IN2&lt;br&gt;TIM4 polled duration&lt;br&gt;Ice: 1 s reverse, 4 s forward" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915" y="665" width="275" height="175" as="geometry"/></mxCell>
        <mxCell id="dcdriver" value="&lt;b&gt;DC driver → ice auger motor&lt;/b&gt;&lt;br&gt;&lt;br&gt;TB6612FNG per link in motor.c&lt;br&gt;PA8 → PWMA/PWMB (comment)&lt;br&gt;PA2 / PA3 → direction control&lt;br&gt;STBY = +5 V per source comment&lt;br&gt;Exact A/B channel pairing is unconfirmed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1400" y="670" width="450" height="175" as="geometry"/></mxCell>
        <mxCell id="edge6" value="PA8 PWM
PA2* / PA3 direction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dc" target="dcdriver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="valvegpio" value="&lt;b&gt;GPIOA valve control&lt;/b&gt;&lt;br&gt;&lt;br&gt;PA4 high = valve 1 on&lt;br&gt;8 s via SysTick blocking delay" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915" y="930" width="275" height="110" as="geometry"/></mxCell>
        <mxCell id="valvedriver" value="&lt;b&gt;Valve power stage → valve 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Position 533 mm; used by selected recipes&lt;br&gt;Driver / relay / transistor part unspecified" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1400" y="930" width="450" height="110" as="geometry"/></mxCell>
        <mxCell id="edge7" value="PA4 on/off" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="valvegpio" target="valvedriver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="systick" value="&lt;b&gt;SysTick&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 MHz polled delay; no IRQ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915" y="1080" width="275" height="90" as="geometry"/></mxCell>
        <mxCell id="conflict" value="&lt;b&gt;* PA2 has two firmware owners&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stepper code writes enable/disable to PA2.&lt;br&gt;Motor code uses PA2 as direction IN1." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fde8e7;strokeColor=#bb5450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1400" y="1090" width="450" height="100" as="geometry"/></mxCell>
        <mxCell id="power" value="&lt;b&gt;Power and physical wiring&lt;/b&gt;&lt;br&gt;&lt;br&gt;Blue Pill: 3.3 V logic / common GND. External drivers, LCD, selector and valve need their own documented supply connections.&lt;br&gt;Supply values, selector routing, A4988 straps/current settings and valve stage are not in the repository; see page 4." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f2eafa;strokeColor=#9165b0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1240" width="1800" height="115" as="geometry"/></mxCell>
        <mxCell id="footer" value="Legend: blue = MCU resources; green = user/debug interface; amber = actuators; purple = power; red = source conflict. Dashed links = functional connection with physical implementation unconfirmed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#596579;" vertex="1" parent="1"><mxGeometry x="50" y="1390" width="1830" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="steppers" name="2 - A4988 and motor selection">
    <mxGraphModel dx="1940" dy="1460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="02 / Stepper selection and A4988 driver bank" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=30;fontColor=#132b46;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1840" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Four logical channels are referenced by the firmware. A4988 driver family supplied in the request; installed quantity and selector IC are not documented." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1830" height="55" as="geometry"/></mxCell>
        <mxCell id="signals" value="&lt;b&gt;STM32 stepper control pins&lt;/b&gt;&lt;br&gt;&lt;br&gt;PA0: DIR output&lt;br&gt;PA1: STEP output from TIM2 ISR&lt;br&gt;PA2: /ENABLE intent, active low&lt;br&gt;PA2 also controls DC IN1 — conflict&lt;br&gt;GPIO push-pull; STEP high ≈ 5 µs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="address" value="&lt;b&gt;STM32 selector pins&lt;/b&gt;&lt;br&gt;&lt;br&gt;PB12: enable, active high&lt;br&gt;PB13: address bit 0 (LSB)&lt;br&gt;PB14: address bit 1&lt;br&gt;PB15: address bit 2 (MSB)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="340" height="165" as="geometry"/></mxCell>
        <mxCell id="selector" value="&lt;b&gt;Selection / signal routing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Functional interface only:&lt;br&gt;choose one of 8 motor indices.&lt;br&gt;&lt;br&gt;Exact decoder/multiplexer IC,&lt;br&gt;output polarity, and whether&lt;br&gt;STEP or /ENABLE is routed&lt;br&gt;are not described in source.&lt;br&gt;&lt;br&gt;DIR / STEP / /ENABLE shown&lt;br&gt;as a logical driver interface,&lt;br&gt;not a verified netlist." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="575" y="250" width="310" height="445" as="geometry"/></mxCell>
        <mxCell id="edge1" value="DIR / STEP / /ENABLE*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.24;" edge="1" parent="1" source="signals" target="selector"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge2" value="EN + 3-bit index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="address" target="selector"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d0" value="&lt;b&gt;A4988 • channel 0 / 000&lt;/b&gt;&lt;br&gt;&lt;br&gt;STEP / DIR / /ENABLE&lt;br&gt;OUT1A/B + OUT2A/B&lt;br&gt;VDD + motor supply + GND" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="205" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="m0" value="&lt;b&gt;Conveyor / cup carriage&lt;/b&gt;&lt;br&gt;&lt;br&gt;moveMM() selects index 0&lt;br&gt;40.38 steps/mm calibration" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="205" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="edge3" value="channel 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.1;entryX=0;entryY=0.5;" edge="1" parent="1" source="selector" target="d0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge4" value="2 motor phases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d0" target="m0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d1" value="&lt;b&gt;A4988 • channel 1 / 001&lt;/b&gt;&lt;br&gt;&lt;br&gt;STEP / DIR / /ENABLE&lt;br&gt;OUT1A/B + OUT2A/B&lt;br&gt;VDD + motor supply + GND" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="395" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Ingredient pump 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;440 mm station&lt;br&gt;Tasty One: 10,000 ms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="395" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="edge5" value="channel 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.36;entryX=0;entryY=0.5;" edge="1" parent="1" source="selector" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge6" value="2 motor phases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d2" value="&lt;b&gt;A4988 • channel 2 / 010&lt;/b&gt;&lt;br&gt;&lt;br&gt;STEP / DIR / /ENABLE&lt;br&gt;OUT1A/B + OUT2A/B&lt;br&gt;VDD + motor supply + GND" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="585" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Ingredient pump 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;150 mm station&lt;br&gt;Drink 2: 1,000 ms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="585" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="edge7" value="channel 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.62;entryX=0;entryY=0.5;" edge="1" parent="1" source="selector" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge8" value="2 motor phases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d3" value="&lt;b&gt;A4988 • channel 3 / 011&lt;/b&gt;&lt;br&gt;&lt;br&gt;STEP / DIR / /ENABLE&lt;br&gt;OUT1A/B + OUT2A/B&lt;br&gt;VDD + motor supply + GND" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="775" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;Ingredient pump 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;250 mm station&lt;br&gt;Drink 2: 2,500 ms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1580" y="775" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="edge9" value="channel 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.88;entryX=0;entryY=0.5;" edge="1" parent="1" source="selector" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge10" value="2 motor phases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="timing" value="&lt;b&gt;Motion timing&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM2: 1 µs nominal counter tick&lt;br&gt;Conveyor: acceleration / cruise / decel&lt;br&gt;Pump: ARR = 1799 (~555.6 steps/s)&lt;br&gt;TIM3: 1 ms tick; stops timed pour&lt;br&gt;Purge: same pump reversed for 3 s&lt;br&gt;Only one shared step stream" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="spare" value="&lt;b&gt;Channels 4 / 5 / 6 / 7&lt;/b&gt;&lt;br&gt;&lt;br&gt;100 / 101 / 110 / 111&lt;br&gt;Not referenced by drink_menu&lt;br&gt;No installed drivers assumed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="575" y="790" width="310" height="140" as="geometry"/></mxCell>
        <mxCell id="edge11" value="remaining addresses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8b94a1;fontColor=#8b94a1;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="selector" target="spare"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="static" value="&lt;b&gt;A4988 local hardware connections — all used channels&lt;/b&gt;&lt;br&gt;&lt;br&gt;MS1 / MS2 / MS3: hardware microstep straps; no MCU pins assigned.&lt;br&gt;/RESET and /SLEEP: hardware bias/straps; no MCU control in firmware.&lt;br&gt;VREF / sense resistors: local phase-current setting; value not documented.&lt;br&gt;VDD: logic supply; VMOT / VBB: motor supply; shared ground reference.&lt;br&gt;Module capacitors / current regulation are local to each driver board.&lt;br&gt;Firmware constant 1600 steps/rev does not establish the actual strap settings." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1060" width="870" height="230" as="geometry"/></mxCell>
        <mxCell id="basis" value="&lt;b&gt;Interpretation and remaining hardware details&lt;/b&gt;&lt;br&gt;&lt;br&gt;Address shown as PB15:PB14:PB13. selectStepper(index) masks to 3 bits.&lt;br&gt;The diagram does not assume that selector outputs connect to /ENABLE.&lt;br&gt;Conveyor/pump part numbers, winding order and installed driver count are unknown.&lt;br&gt;startMove() and startPour() map their dir parameter to PA0 with opposite polarity.&lt;br&gt;Every driver needs its own configured current limit and motor-phase wiring.&lt;br&gt;Driver pin functions: Allegro A4988 datasheet; project mapping: stepper.c / selector.c." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="1060" width="870" height="230" as="geometry"/></mxCell>
        <mxCell id="footer" value="Sources: Src/stepper.c • Src/selector.c • Src/drinks.c • Src/main.c. A4988 reference: allegromicro.com/~/media/Files/Datasheets/A4988-Datasheet.pdf" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#596579;" vertex="1" parent="1"><mxGeometry x="50" y="1390" width="1830" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="timing" name="3 - Clocks timers and interrupts">
    <mxGraphModel dx="1940" dy="1460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="03 / Clock tree, timers and interrupt paths" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=30;fontColor=#132b46;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1840" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Clock frequencies below follow the reset-default 8 MHz HSI configuration in SystemInit(); timer rates are the programmed nominal values." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1830" height="55" as="geometry"/></mxCell>
        <mxCell id="hsi" value="&lt;b&gt;HSI internal oscillator&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 MHz; HSE / PLL not enabled" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="rcc" value="&lt;b&gt;RCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;SYSCLK = HCLK = 8 MHz&lt;br&gt;APB1 / APB2 prescalers = 1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="edge1" value="8 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hsi" target="rcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="apb1" value="&lt;b&gt;APB1 clock gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 MHz: TIM2, TIM3, TIM4, I²C1&lt;br&gt;TIM3 gate also enabled in button.c&lt;br&gt;No separate timer debounce logic" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="160" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="apb2" value="&lt;b&gt;APB2 clock gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 MHz: TIM1, GPIOA/B/C, AFIO&lt;br&gt;AFIO routes PB8/PB9 to EXTI&lt;br&gt;Default peripheral pin mappings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470" y="160" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="edge2" value="PCLK1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rcc" target="apb1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge3" value="PCLK2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="rcc" target="apb2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655" y="145"/><mxPoint x="1665" y="145"/></Array></mxGeometry></mxCell>
        <mxCell id="clocknote" value="AHB/core also supplies SysTick (HCLK/8) and NVIC. Flash holds firmware/recipes; SRAM holds state, stack, heap and the I²C queue. No external memory is configured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="325" width="1810" height="50" as="geometry"/></mxCell>
        <mxCell id="tim2" value="&lt;b&gt;TIM2 • step scheduler&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB1 → 8 MHz&lt;br&gt;PSC = 7 → 1 MHz counter&lt;br&gt;Variable ARR for motion ramp&lt;br&gt;Pump ARR = 1799&lt;br&gt;Update interrupt enabled&lt;br&gt;ISR toggles PA1 as GPIO&lt;br&gt;No TIM2 output channel used" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="280" height="235" as="geometry"/></mxCell>
        <mxCell id="tim3" value="&lt;b&gt;TIM3 • pour / purge&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB1 → 8 MHz&lt;br&gt;PSC = 7999 → 1 kHz&lt;br&gt;ARR = duration_ms − 1&lt;br&gt;Update interrupt enabled&lt;br&gt;Stops TIM2 and TIM3&lt;br&gt;Disables selector / driver&lt;br&gt;No timer output pin" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="420" width="280" height="235" as="geometry"/></mxCell>
        <mxCell id="tim4" value="&lt;b&gt;TIM4 • ice run time&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB1 → 8 MHz&lt;br&gt;PSC = 7999 → 1 kHz&lt;br&gt;ARR = requested ms&lt;br&gt;UIF polled; no IRQ&lt;br&gt;Blocks motorRunMS()&lt;br&gt;Period is (ARR + 1) ticks&lt;br&gt;No timer output pin" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="420" width="280" height="235" as="geometry"/></mxCell>
        <mxCell id="tim1" value="&lt;b&gt;TIM1 • ice PWM&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB2 → 8 MHz&lt;br&gt;PSC = 0; ARR = 499&lt;br&gt;CH1 PWM mode 1 / MOE&lt;br&gt;16 kHz on PA8&lt;br&gt;CCR1 controls duty&lt;br&gt;No TIM1 interrupt&lt;br&gt;50% / 100% requested in main" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="420" width="280" height="235" as="geometry"/></mxCell>
        <mxCell id="stk" value="&lt;b&gt;SysTick • delays&lt;/b&gt;&lt;br&gt;&lt;br&gt;HCLK/8 = 1 MHz&lt;br&gt;CTRL = 0x1; TICKINT = 0&lt;br&gt;COUNTFLAG polling&lt;br&gt;5 µs STEP pulse high&lt;br&gt;LCD startup / write delays&lt;br&gt;8 s valve dwell&lt;br&gt;No SysTick interrupt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1290" y="420" width="280" height="235" as="geometry"/></mxCell>
        <mxCell id="i2c" value="&lt;b&gt;I²C1 • display&lt;/b&gt;&lt;br&gt;&lt;br&gt;PCLK1 = 8 MHz&lt;br&gt;CR2 FREQ = 8&lt;br&gt;CCR = 40; TRISE = 9&lt;br&gt;100 kHz standard mode&lt;br&gt;PB6 SCL / PB7 SDA&lt;br&gt;Event IRQ for queued TX&lt;br&gt;Blocking LCD initialization" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1600" y="420" width="280" height="235" as="geometry"/></mxCell>
        <mxCell id="irqtitle" value="Interrupts used by application code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="1700" height="45" as="geometry"/></mxCell>
        <mxCell id="irqstep" value="&lt;b&gt;TIM2 / TIM3 update sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM2_IRQHandler: pulse + motion count&lt;br&gt;TIM3_IRQHandler: timed pour completion&lt;br&gt;Set stepper_done; restore button masks" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="irqbtn" value="&lt;b&gt;AFIO → EXTI8 / EXTI9&lt;/b&gt;&lt;br&gt;&lt;br&gt;PB8 / PB9 falling-edge detection&lt;br&gt;EXTI9_5_IRQHandler sets btn8 / btn9&lt;br&gt;Lines masked during selected actions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="790" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="irqi2c" value="&lt;b&gt;I²C1 interrupt sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;I2C1_EV_IRQHandler: START / ADDR / BTF&lt;br&gt;I2C1_ER_IRQHandler exists; NVIC enabled&lt;br&gt;CR2 ITERREN is not set by current code" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="790" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="polling" value="&lt;b&gt;Polling resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM4 and SysTick do not enter NVIC&lt;br&gt;TIM1 generates PWM in hardware&lt;br&gt;I²C startup also uses polling" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1490" y="790" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="nvic" value="&lt;b&gt;NVIC → Cortex-M3 interrupt handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enabled lines: TIM2, TIM3, EXTI9_5, I2C1_EV, I2C1_ER; no application priority assignments" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1020" width="1360" height="95" as="geometry"/></mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="irqstep" target="nvic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="irqbtn" target="nvic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="irqi2c" target="nvic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="main" value="&lt;b&gt;main.c state machine + drinks.c recipes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Menu → move to ice (225 mm) → break / dispense → optional valve (533 mm) → ingredient stations → purge → return to position 0.&lt;br&gt;Main loop services i2c_process(); ISR flags advance actions. Position is software-tracked; no home switch / encoder input is configured." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1180" width="1360" height="115" as="geometry"/></mxCell>
        <mxCell id="edge7" value="flags / queue progress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nvic" target="main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="notused" value="&lt;b&gt;Not configured by this application&lt;/b&gt;&lt;br&gt;&lt;br&gt;ADC / DMA / DAC&lt;br&gt;SPI / USART / UART / CAN / USB&lt;br&gt;RTC / watchdog / backup domain&lt;br&gt;External memory / sensor interfaces&lt;br&gt;&lt;br&gt;Header definitions and weak startup&lt;br&gt;vector entries do not imply use.&lt;br&gt;&lt;br&gt;printf syscall stubs do not configure&lt;br&gt;a serial peripheral." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1490" y="1010" width="390" height="285" as="geometry"/></mxCell>
        <mxCell id="footer" value="Sources: Src/system_stm32f1xx.c • stepper.c • motor.c • delay.c • i2c.c • button.c • main.c. Clock/reset behavior: ST RM0008. Rates are configuration-derived, not measured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#596579;" vertex="1" parent="1"><mxGeometry x="50" y="1390" width="1830" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="inventory" name="4 - Pin inventory power and open details">
    <mxGraphModel dx="1940" dy="1460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1740" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="04 / Pin inventory, power domains and hardware evidence" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=30;fontColor=#132b46;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1840" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Solid MCU assignments come from register writes or README debug wiring. Unspecified external circuits are labeled; this diagram is not a verified electrical schematic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1830" height="55" as="geometry"/></mxCell>
