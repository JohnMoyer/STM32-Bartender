                <mxCell id="m2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" value="&lt;b&gt;Ingredient pump 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;150 mm station&lt;br&gt;Drink 2: 1,000 ms" vertex="1">
                    <mxGeometry height="140" width="300" x="1580" y="585" as="geometry"/>
                </mxCell>
                <mxCell id="edge7" edge="1" parent="1" source="selector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.62;entryX=0;entryY=0.5;" target="d2" value="channel 2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge8" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="m2" value="2 motor phases">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" value="&lt;b&gt;A4988 • channel 3 / 011&lt;/b&gt;&lt;br&gt;&lt;br&gt;STEP / DIR / /ENABLE&lt;br&gt;OUT1A/B + OUT2A/B&lt;br&gt;VDD + motor supply + GND" vertex="1">
                    <mxGeometry height="140" width="300" x="1120" y="775" as="geometry"/>
                </mxCell>
                <mxCell id="m3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e9f5ee;strokeColor=#4d8865;strokeWidth=1.5;" value="&lt;b&gt;Ingredient pump 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;250 mm station&lt;br&gt;Drink 2: 2,500 ms" vertex="1">
                    <mxGeometry height="140" width="300" x="1580" y="775" as="geometry"/>
                </mxCell>
                <mxCell id="edge9" edge="1" parent="1" source="selector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.88;entryX=0;entryY=0.5;" target="d3" value="channel 3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge10" edge="1" parent="1" source="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b18a38;fontColor=#b18a38;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="m3" value="2 motor phases">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="timing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;Motion timing&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM2: 1 µs nominal counter tick&lt;br&gt;Conveyor: acceleration / cruise / decel&lt;br&gt;Pump: ARR = 1799 (~555.6 steps/s)&lt;br&gt;TIM3: 1 ms tick; stops timed pour&lt;br&gt;Purge: same pump reversed for 3 s&lt;br&gt;Only one shared step stream" vertex="1">
                    <mxGeometry height="200" width="340" x="50" y="780" as="geometry"/>
                </mxCell>
                <mxCell id="spare" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;dashed=1;" value="&lt;b&gt;Channels 4 / 5 / 6 / 7&lt;/b&gt;&lt;br&gt;&lt;br&gt;100 / 101 / 110 / 111&lt;br&gt;Not referenced by drink_menu&lt;br&gt;No installed drivers assumed" vertex="1">
                    <mxGeometry height="140" width="310" x="575" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="edge11" edge="1" parent="1" source="selector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8b94a1;fontColor=#8b94a1;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="spare" value="remaining addresses">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="static" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#fff1d6;strokeColor=#b18a38;strokeWidth=1.5;" value="&lt;b&gt;A4988 local hardware connections — all used channels&lt;/b&gt;&lt;br&gt;&lt;br&gt;MS1 / MS2 / MS3: hardware microstep straps; no MCU pins assigned.&lt;br&gt;/RESET and /SLEEP: hardware bias/straps; no MCU control in firmware.&lt;br&gt;VREF / sense resistors: local phase-current setting; value not documented.&lt;br&gt;VDD: logic supply; VMOT / VBB: motor supply; shared ground reference.&lt;br&gt;Module capacitors / current regulation are local to each driver board.&lt;br&gt;Firmware constant 1600 steps/rev does not establish the actual strap settings." vertex="1">
                    <mxGeometry height="230" width="870" x="50" y="1060" as="geometry"/>
                </mxCell>
                <mxCell id="basis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" value="&lt;b&gt;Interpretation and remaining hardware details&lt;/b&gt;&lt;br&gt;&lt;br&gt;Address shown as PB15:PB14:PB13. selectStepper(index) masks to 3 bits.&lt;br&gt;The diagram does not assume that selector outputs connect to /ENABLE.&lt;br&gt;Conveyor/pump part numbers, winding order and installed driver count are unknown.&lt;br&gt;startMove() and startPour() map their dir parameter to PA0 with opposite polarity.&lt;br&gt;Every driver needs its own configured current limit and motor-phase wiring.&lt;br&gt;Driver pin functions: Allegro A4988 datasheet; project mapping: stepper.c / selector.c." vertex="1">
                    <mxGeometry height="230" width="870" x="1010" y="1060" as="geometry"/>
                </mxCell>
                <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#596579;" value="Sources: Src/stepper.c • Src/selector.c • Src/drinks.c • Src/main.c. A4988 reference: allegromicro.com/~/media/Files/Datasheets/A4988-Datasheet.pdf" vertex="1">
                    <mxGeometry height="45" width="1830" x="50" y="1390" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="timing" name="3 - Clocks timers and interrupts">
        <mxGraphModel dx="2235" dy="1428" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1460" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=30;fontColor=#132b46;" value="03 / Clock tree, timers and interrupt paths" vertex="1">
                    <mxGeometry height="55" width="1840" x="50" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" value="Clock frequencies below follow the reset-default 8 MHz HSI configuration in SystemInit(); timer rates are the programmed nominal values." vertex="1">
                    <mxGeometry height="55" width="1830" x="50" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="hsi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;HSI internal oscillator&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 MHz; HSE / PLL not enabled" vertex="1">
                    <mxGeometry height="100" width="300" x="50" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="rcc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;RCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;SYSCLK = HCLK = 8 MHz&lt;br&gt;APB1 / APB2 prescalers = 1" vertex="1">
                    <mxGeometry height="100" width="350" x="480" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="edge1" edge="1" parent="1" source="hsi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;" target="rcc" value="8 MHz">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="apb1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;APB1 clock gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 MHz: TIM2, TIM3, TIM4, I²C1&lt;br&gt;TIM3 gate also enabled in button.c&lt;br&gt;No separate timer debounce logic" vertex="1">
                    <mxGeometry height="140" width="390" x="960" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="apb2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;APB2 clock gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 MHz: TIM1, GPIOA/B/C, AFIO&lt;br&gt;AFIO routes PB8/PB9 to EXTI&lt;br&gt;Default peripheral pin mappings" vertex="1">
                    <mxGeometry height="140" width="390" x="1470" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="edge2" edge="1" parent="1" source="rcc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;" target="apb1" value="PCLK1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge3" edge="1" parent="1" source="rcc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="apb2" value="PCLK2">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="655" y="145"/>
                            <mxPoint x="1665" y="145"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="clocknote" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#334155;" value="AHB/core also supplies SysTick (HCLK/8) and NVIC. Flash holds firmware/recipes; SRAM holds state, stack, heap and the I²C queue. No external memory is configured." vertex="1">
                    <mxGeometry height="50" width="1810" x="50" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="tim2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;TIM2 • step scheduler&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB1 → 8 MHz&lt;br&gt;PSC = 7 → 1 MHz counter&lt;br&gt;Variable ARR for motion ramp&lt;br&gt;Pump ARR = 1799&lt;br&gt;Update interrupt enabled&lt;br&gt;ISR toggles PA1 as GPIO&lt;br&gt;No TIM2 output channel used" vertex="1">
                    <mxGeometry height="235" width="280" x="50" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="tim3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;TIM3 • pour / purge&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB1 → 8 MHz&lt;br&gt;PSC = 7999 → 1 kHz&lt;br&gt;ARR = duration_ms − 1&lt;br&gt;Update interrupt enabled&lt;br&gt;Stops TIM2 and TIM3&lt;br&gt;Disables selector / driver&lt;br&gt;No timer output pin" vertex="1">
                    <mxGeometry height="235" width="280" x="360" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="tim4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;TIM4 • ice run time&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB1 → 8 MHz&lt;br&gt;PSC = 7999 → 1 kHz&lt;br&gt;ARR = requested ms&lt;br&gt;UIF polled; no IRQ&lt;br&gt;Blocks motorRunMS()&lt;br&gt;Period is (ARR + 1) ticks&lt;br&gt;No timer output pin" vertex="1">
                    <mxGeometry height="235" width="280" x="670" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="tim1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;TIM1 • ice PWM&lt;/b&gt;&lt;br&gt;&lt;br&gt;APB2 → 8 MHz&lt;br&gt;PSC = 0; ARR = 499&lt;br&gt;CH1 PWM mode 1 / MOE&lt;br&gt;16 kHz on PA8&lt;br&gt;CCR1 controls duty&lt;br&gt;No TIM1 interrupt&lt;br&gt;50% / 100% requested in main" vertex="1">
                    <mxGeometry height="235" width="280" x="980" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="stk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;SysTick • delays&lt;/b&gt;&lt;br&gt;&lt;br&gt;HCLK/8 = 1 MHz&lt;br&gt;CTRL = 0x1; TICKINT = 0&lt;br&gt;COUNTFLAG polling&lt;br&gt;5 µs STEP pulse high&lt;br&gt;LCD startup / write delays&lt;br&gt;8 s valve dwell&lt;br&gt;No SysTick interrupt" vertex="1">
                    <mxGeometry height="235" width="280" x="1290" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="i2c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;I²C1 • display&lt;/b&gt;&lt;br&gt;&lt;br&gt;PCLK1 = 8 MHz&lt;br&gt;CR2 FREQ = 8&lt;br&gt;CCR = 40; TRISE = 9&lt;br&gt;100 kHz standard mode&lt;br&gt;PB6 SCL / PB7 SDA&lt;br&gt;Event IRQ for queued TX&lt;br&gt;Blocking LCD initialization" vertex="1">
                    <mxGeometry height="235" width="280" x="1600" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="irqtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=24;fontColor=#334155;" value="Interrupts used by application code" vertex="1">
                    <mxGeometry height="45" width="1700" x="50" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="irqstep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;TIM2 / TIM3 update sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM2_IRQHandler: pulse + motion count&lt;br&gt;TIM3_IRQHandler: timed pour completion&lt;br&gt;Set stepper_done; restore button masks" vertex="1">
                    <mxGeometry height="140" width="400" x="50" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="irqbtn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;AFIO → EXTI8 / EXTI9&lt;/b&gt;&lt;br&gt;&lt;br&gt;PB8 / PB9 falling-edge detection&lt;br&gt;EXTI9_5_IRQHandler sets btn8 / btn9&lt;br&gt;Lines masked during selected actions" vertex="1">
                    <mxGeometry height="140" width="400" x="530" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="irqi2c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;I²C1 interrupt sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;I2C1_EV_IRQHandler: START / ADDR / BTF&lt;br&gt;I2C1_ER_IRQHandler exists; NVIC enabled&lt;br&gt;CR2 ITERREN is not set by current code" vertex="1">
                    <mxGeometry height="140" width="400" x="1010" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="polling" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" value="&lt;b&gt;Polling resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;TIM4 and SysTick do not enter NVIC&lt;br&gt;TIM1 generates PWM in hardware&lt;br&gt;I²C startup also uses polling" vertex="1">
                    <mxGeometry height="140" width="390" x="1490" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="nvic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;NVIC → Cortex-M3 interrupt handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enabled lines: TIM2, TIM3, EXTI9_5, I2C1_EV, I2C1_ER; no application priority assignments" vertex="1">
                    <mxGeometry height="95" width="1360" x="50" y="1020" as="geometry"/>
                </mxCell>
                <mxCell id="edge4" edge="1" parent="1" source="irqstep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" target="nvic" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge5" edge="1" parent="1" source="irqbtn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="nvic" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge6" edge="1" parent="1" source="irqi2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" target="nvic" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#e7f0ff;strokeColor=#4974a5;strokeWidth=1.5;" value="&lt;b&gt;main.c state machine + drinks.c recipes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Menu → move to ice (225 mm) → break / dispense → optional valve (533 mm) → ingredient stations → purge → return to position 0.&lt;br&gt;Main loop services i2c_process(); ISR flags advance actions. Position is software-tracked; no home switch / encoder input is configured." vertex="1">
                    <mxGeometry height="115" width="1360" x="50" y="1180" as="geometry"/>
                </mxCell>
                <mxCell id="edge7" edge="1" parent="1" source="nvic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4974a5;fontColor=#4974a5;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="main" value="flags / queue progress">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="notused" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fontFamily=Helvetica;fillColor=#f4f5f7;strokeColor=#8b94a1;strokeWidth=1.5;" value="&lt;b&gt;Not configured by this application&lt;/b&gt;&lt;br&gt;&lt;br&gt;ADC / DMA / DAC&lt;br&gt;SPI / USART / UART / CAN / USB&lt;br&gt;RTC / watchdog / backup domain&lt;br&gt;External memory / sensor interfaces&lt;br&gt;&lt;br&gt;Header definitions and weak startup&lt;br&gt;vector entries do not imply use.&lt;br&gt;&lt;br&gt;printf syscall stubs do not configure&lt;br&gt;a serial peripheral." vertex="1">
                    <mxGeometry height="285" width="390" x="1490" y="1010" as="geometry"/>
                </mxCell>
                <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#596579;" value="Sources: Src/system_stm32f1xx.c • stepper.c • motor.c • delay.c • i2c.c • button.c • main.c. Clock/reset behavior: ST RM0008. Rates are configuration-derived, not measured." vertex="1">
                    <mxGeometry height="45" width="1830" x="50" y="1390" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="inventory" name="4 - Pin inventory power and open details">
        <mxGraphModel dx="1900" dy="1214" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1740" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=30;fontColor=#132b46;" value="04 / Pin inventory, power domains and hardware evidence" vertex="1">
